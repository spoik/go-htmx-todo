package templates

import (
	"fmt"
	"github.com/spoik/go-htmx-todo/internal/database/queries"
	"github.com/spoik/go-htmx-todo/internal/server/routes"
	"strconv"
)

templ Todos(todos []queries.Todo) {
	@layout() {
		<h1 class="text-3xl">Todos</h1>
		<ul class="mt-6 grid gap-4">
			for _, t:= range todos {
				<li>
					@Todo(t)
				</li>
			}
		</ul>
	}
}

templ Todo(todo queries.Todo) {
	{{ id := fmt.Sprintf("todo-%d", todo.ID) }}
	{{ labelId := "label-" + id }}
	<label
		class="bg-blue-900 p-4 flex rounded-lg"
		for={ id }
		id={ labelId }
	>
		<input
			type="checkbox"
			checked?={ todo.Complete.Bool }
			name={ id }
			id={ id }
			hx-put={ routes.ToggleTodoComplete.Reverse("id", strconv.Itoa(int(todo.ID))) }
			hx-trigger="change"
			hx-target={ "#" + labelId }
			hx-swap="outerHTML"
		/>
		<p class="ml-4">{ todo.Title }</p>
	</label>
}
