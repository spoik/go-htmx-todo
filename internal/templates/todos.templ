package templates

import (
	"github.com/spoik/go-htmx-todo/internal/server/routes"
	"github.com/spoik/go-htmx-todo/internal/templates/viewmodels"
)

templ Todos(todos []viewmodels.Todo) {
	@layout() {
		<h1 class="text-3xl">Todos</h1>
		<ul id="todos" class="mt-6 grid gap-4">
			for _, t:= range todos {
				@TodoListElement(t)
			}
		</ul>
		<div class="mt-3">
			@AddTodo()
		</div>
	}
}

templ AddTodo() {
	<a
		href="#"
		hx-get={ routes.NewTodo.Reverse() }
		hx-swap="outerHTML"
	>+ Add todo</a>
}

templ TodoListElement(todo viewmodels.Todo) {
	<li>
		@Todo(todo, "")
	</li>
}

templ Todo(todo viewmodels.Todo, err string) {
	<div hx-target="this">
		<label
			class="flex items-center bg-blue-900 p-4 rounded-lg group"
			for={ todo.InputId() }
			id={ todo.LabelId() }
		>
			@todoCompleteForm(todo)
			<p class="ml-4">{ todo.Title }</p>
			@deleteTodoForm(todo)
		</label>
		if err != "" {
			<div class="mt-2">
				@Error(err)
			</div>
		}
	</div>
}

templ todoCompleteForm(todo viewmodels.Todo) {
	<form hx-put={ todo.ToggleCompleteUrl } hx-trigger="change" hx-swap="outerHTML">
		<input
			type="checkbox"
			checked?={ todo.IsCompleted() }
			name="complete"
			id={ todo.InputId() }
		/>
	</form>
}

templ deleteTodoForm(todo viewmodels.Todo) {
	<form
		class="flex ml-auto invisible group-hover:visible"
		hx-delete={ todo.DeleteUrl }
	>
		<button class="inline-block cursor-pointer">
			@trashIcon()
		</button>
	</form>
}

templ trashIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
		<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"></path>
	</svg>
}

templ TodoForm(title string, err string) {
	<div hx-target="this">
		<form
			hx-post={ routes.CreateTodo.Reverse() }
			class="flex gap-4"
			hx-swap="outerHTML"
		>
			<label for="new-todo-title" class="sr-only">Title</label>
			<input
				type="text"
				id="new-todo-title"
				name="title"
				class="flex-auto bg-white p-2 text-black"
				value={ title }
			/>
			<input type="submit" class="py-2 px-4 bg-blue-900 " value="Add"/>
		</form>
		if err != "" {
			<div class="mt-2">
				@Error(err)
			</div>
		}
	</div>
}

templ TodoCreated(todo viewmodels.Todo) {
	<div id="todos" hx-swap-oob="afterbegin">
		@TodoListElement(todo)
	</div>
	@AddTodo()
}
